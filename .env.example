# ============================================================
# PROJECT
# ============================================================

# Environment: development / production
APP_ENV=development


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Databases
USER_DB_NAME=user_db
BOOKING_DB_NAME=booking_db
NOTIFICATION_DB_NAME=notification_db

# Database users
USER_DB_USER=user_user
USER_DB_PASSWORD=user_password

BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_password

NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_password


# ============================================================
# USER SERVICE
# ============================================================

USER_SERVICE_PORT=8081

USER_HTTP_READ_TIMEOUT=10s
USER_HTTP_WRITE_TIMEOUT=15s
USER_HTTP_IDLE_TIMEOUT=60s

USER_DATABASE_URL=postgres://user_user:user_password@postgres:5432/user_db?sslmode=disable

# Default appointment slot duration
USER_SLOT_DURATION=60m


# ============================================================
# BOOKING SERVICE
# ============================================================

BOOKING_SERVICE_PORT=8083

BOOKING_HTTP_READ_TIMEOUT=10s
BOOKING_HTTP_WRITE_TIMEOUT=15s
BOOKING_HTTP_IDLE_TIMEOUT=60s

BOOKING_DATABASE_URL=postgres://booking_user:booking_password@postgres:5432/booking_db?sslmode=disable

# Internal service URLs
BOOKING_USER_SERVICE_URL=http://user-service:8081
BOOKING_NOTIFICATION_SERVICE_URL=http://notification-service:8082


# ============================================================
# NOTIFICATION SERVICE
# ============================================================

NOTIFICATION_SERVICE_PORT=8082

NOTIFICATION_HTTP_READ_TIMEOUT=10s
NOTIFICATION_HTTP_WRITE_TIMEOUT=15s
NOTIFICATION_HTTP_IDLE_TIMEOUT=60s

NOTIFICATION_DATABASE_URL=postgres://notification_user:notification_password@postgres:5432/notification_db?sslmode=disable


# ============================================================
# SMTP / MAILPIT
# ============================================================

SMTP_HOST=mailpit
SMTP_PORT=1025

SMTP_USERNAME=
SMTP_PASSWORD=

SMTP_FROM=notifications@example.local

# Mailpit Web UI
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025


# ============================================================
# HOST PORTS
# ============================================================

# PostgreSQL exposed on host
POSTGRES_EXTERNAL_PORT=5432

# User service exposed on host
USER_EXTERNAL_PORT=8081

# Booking service exposed on host
BOOKING_EXTERNAL_PORT=8083

# Notification service exposed on host
NOTIFICATION_EXTERNAL_PORT=8082